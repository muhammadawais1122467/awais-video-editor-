# Copy to `.env` and fill in. Values are baked in at build time (`npm run build`).

# Public URL of the deployed site, with trailing slash. Enables canonical URLs,
# absolute social-image URLs, sitemap.xml and the robots.txt sitemap line.
VITE_SITE_URL=

# Contact form delivery. Leave empty until a real endpoint exists — the form then
# tells visitors honestly that online delivery isn't set up and offers LinkedIn.
#   formspree : VITE_CONTACT_ENDPOINT=https://formspree.io/f/xxxxxxxx
#   web3forms : VITE_CONTACT_ENDPOINT=https://api.web3forms.com/submit  + VITE_CONTACT_ACCESS_KEY
#   json      : any endpoint accepting a JSON POST that returns 2xx on success
VITE_CONTACT_PROVIDER=formspree
VITE_CONTACT_ENDPOINT=
VITE_CONTACT_ACCESS_KEY=
